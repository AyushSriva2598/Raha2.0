# Raha Frontend Environment Configuration

# Backend API URL (leave blank to use Mock client, or set to your backend server)
# For local development with backend:
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Maps API Key (Powers native Google Maps SDK & Web Google Maps JS API)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Ngrok Personal Authtoken (Optional - ensures dedicated tunnel connection without shared pool limits)
# Get a free authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_authtoken_here
