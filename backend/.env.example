# Server configuration
PORT=4000
NODE_ENV=development

# PostgreSQL / PostGIS database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raha_db

# Webhook bridge authentication secret (AWS Step Functions / SageMaker caller)
AWS_WEBHOOK_SECRET=raha_internal_sagemaker_sync_secret_key_2026

# CORS allowed origins (Expo Web and native mobile)
CORS_ORIGIN=*

# Google Maps API Key (Optional: for backend directions / elevation calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
