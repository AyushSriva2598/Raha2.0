# Server configuration
PORT=4000
NODE_ENV=development

# PostgreSQL / PostGIS database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raha_db

# Webhook bridge authentication secret (AWS Step Functions / SageMaker caller)
AWS_WEBHOOK_SECRET=change_me_to_a_long_random_string

# CORS allowed origins (Expo Web and native mobile)
CORS_ORIGIN=*

# Google Maps API Key (Optional: for backend directions / elevation calculation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Messaging (leave as is until AWS is ready) ---
# SMS_PROVIDER: none (default, nothing is ever sent) or sns (Amazon SNS transactional SMS)
SMS_PROVIDER=none
# Region for SNS. Credentials come from the normal AWS chain (Lambda role, profile or env), never from this file.
AWS_REGION=ap-south-1
# Optional alphanumeric sender id (India needs DLT registration before this works)
SMS_SENDER_ID=
# SOS_LIVE=true lets the SOS button really text contacts. Keep false until you have tested with numbers you control.
SOS_LIVE=false
SOS_MAX_PER_DAY=5

# --- Road routing ---
# ROUTING_PROVIDER: osrm (default) or none. The public OSRM demo is for development only: for real use
# run your own OSRM/Valhalla (or an AWS-hosted engine with the same API) and set OSRM_URL to it.
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=10000
