{
  "name": "raha-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Raha - Glacial Threat Early Warning System (Himalayan Basin)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start": "cd frontend && node ./scripts/start.js",
    "start:tunnel": "cd frontend && node ./scripts/start.js --start-tunnel",
    "start:frontend": "npm --prefix frontend start",
    "start:frontend:tunnel": "cd frontend && bun start --start-tunnel",
    "start:backend": "npm --prefix backend run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend start\"",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "build:backend": "npm --prefix backend run build"
  }
}
